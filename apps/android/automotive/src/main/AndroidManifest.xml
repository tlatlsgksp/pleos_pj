<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- VehicleRecordingService keeps the process alive so drives and charges are recorded while
         another app (usually the navigation) covers this one. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Pleos Connect SDK permissions. Declaring them is enough on the emulator during the contest;
         App Market review only accepts the ones approved for the app, so drop unused ones before release.
         See docs/PLEOS_PLATFORM_RESEARCH.md 3.1 and 4.2. -->
    <!-- Vehicle: read domains -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_MIRRORS" />
    <uses-permission android:name="pleos.car.permission.CAR_TOLL" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <!-- Vehicle: control (verified on the emulator for ambient lights) -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <!-- NaviHelper -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <!-- SpeechToText / TextToSpeech -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- FusedLocation (dangerous: request it at runtime as well) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />

    <application
        android:name=".PleosApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pleos">

        <meta-data
            android:name="com.naver.maps.map.NCP_KEY_ID"
            android:value="${naverClientId}" />

        <!-- Mobility Services category. Not Distraction Optimized yet, so the app is available only while parked.
             screenOrientation is unset so the app opens in portrait in a single window. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Pleos">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.VehicleRecordingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Records odometer, drive sessions and EV charging from vehicle signals while other apps are in front" />
        </service>
    </application>

</manifest>
