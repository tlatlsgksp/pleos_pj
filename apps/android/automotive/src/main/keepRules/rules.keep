# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# Pleos SDKs (Vehicle, NaviHelper) look up their permission annotations with Kotlin reflection.
# Optimizing kotlin.** broke every vehicle read in the release build (InvocationTargetException),
# so the SDKs, Kotlin metadata and kotlin-reflect stay as they are.
-keep class ai.pleos.** { *; }
-keep interface ai.pleos.** { *; }
-keep class kotlin.Metadata { *; }
-keep class kotlin.reflect.** { *; }
-keep class kotlin.jvm.internal.** { *; }
# kotlin-reflect reads @Deprecated(replaceWith = ...) on SDK methods; once R8 renamed kotlin.Deprecated
# and dropped its elements every read failed with IncompleteAnnotationException.
-keep @interface kotlin.** { *; }
-keep class kotlin.ReplaceWith { *; }
-keep enum kotlin.DeprecationLevel { *; }
-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod,RuntimeVisibleAnnotations
