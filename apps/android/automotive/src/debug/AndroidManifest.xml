<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Lets adb set a navigation destination for demos and checks.
     Usage is in DebugRouteReceiver. Guarded by DUMP, which only the shell holds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugRouteReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.example.pleos.debug.SET_ROUTE" />
                <action android:name="com.example.pleos.debug.CANCEL_ROUTE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
