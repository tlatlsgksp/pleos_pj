# Copy to .env and adjust. .env is gitignored.
# Validated at boot by src/config/env.ts; the app refuses to start on invalid values.
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://pleos:pleos@localhost:5432/pleos?schema=public"
REDIS_URL="redis://localhost:6379"
# HMAC key for pseudonymizing VINs. Use a long random value outside development.
VIN_HMAC_SECRET="dev-only-change-me-0123456789"
